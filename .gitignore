# Generated by Cargo
# Will contain the executable when built
/target/

# Generated by rustfmt
# Backup files of the rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
# .pdb files are for the Microsoft Visual Studio debugger
*.pdb

# Cargo mutants, a mutation testing tool, generates this directory
**/mutants.out/

# RustRover (JetBrains IDE)
.idea/

*.redb
vector.hnsw
benchmarks/.env.benchmarks.local
benchmarks/LongMemEval/data/longmemeval_s_cleaned.json
benchmarks/results/LongMemEval/
benchmarks/ranking_tuner/*
*.*_hnsw
*.db
/tenants/*
/.fastembed_cache/*
*.db-wal
*.db-shm

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.tfstate.lock.info
# Python bytecode cache (bindings/python)
__pycache__/
*.pyc
.DS_Store

# Benchmark run outputs. Smoke runs are cheap and regenerate locally; dev- and
# paper-tier records are the evidence behind published numbers and cost GPU
# hours on a rented box, so they are tracked. Engine logs are server noise.
/benchmarks/runs/*_smoke*/
/benchmarks/runs/**/engine.log
/benchmarks/snapshots/
